# =========================
# LLM CONFIGURATION
# =========================
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_MAX_RETRIES=3
LLM_TIMEOUT=120.0

SUMMARIZER_MODEL=gemini-2.5-flash
LLM_MAX_HISTORY_MESSAGES=20
LLM_CONFIANCA_MINIMA=0.25

# =========================
# AGENTIC RAG & SKILLS
# =========================
MAX_RETRIEVAL_ATTEMPTS=3
MAX_AGENT_STEPS=8
SKILLS_DIR=./skills

# =========================
# QDRANT CONFIGURATION
# =========================
# Deixe QDRANT_URL vazio para rodar 100% local em disco (QDRANT_PATH)
QDRANT_URL=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION_NAME=ctb_assist_docs
QDRANT_DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
QDRANT_DENSE_SIZE=384
QDRANT_SPARSE_MODEL=Qdrant/bm42-all-minilm-l6-v2-attentions
QDRANT_TOP_K=8

# =========================
# DOCUMENTOS E SPLITTER
# =========================
DOCS_DIR=./docs
PROCESSED_DATA_DIR=./data/processed
SPLITTER_CHUNK_SIZE=1400
SPLITTER_CHUNK_OVERLAP=120

# =========================
# RERANKER CONFIGURATION
# =========================
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8
RERANKER_TOP_K=5
RERANKER_BATCH_SIZE=8

# =========================
# MEMORY (OPTIONAL REDIS)
# =========================
REDIS_URL=
TIME_TO_LIVE=86400

# =========================
# MCP SERVERS
# =========================
MCP_CTB_SERVER_URL=
MCP_FETCH_ENABLED=true
